{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeakEase",
  "version": "0.1.0",
  "identifier": "com.wblekhoa.speakease",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": ["resources/**/*"],
    "license": "PolyForm-Noncommercial-1.0.0 AND MIT",
    "copyright": "© 2026 Lê Khoa. Built on Handy, © 2025 CJ Pais (MIT).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/legal/LICENSE.txt": "../LICENSE",
        "Resources/legal/LICENSE-MIT-HANDY.txt": "../LICENSE-MIT-HANDY",
        "Resources/legal/NOTICE.md": "../NOTICE.md"
      },
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Khoa Le (5QBA98WXJL)",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libopenblas0"],
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/Handy": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QzM1ODg1NTgwMEU4QzEKUldUQjZBQlloVmpEWlRJSUQ4Nm9TNDFHTncxVmNpUGFDWk0yR1hTWWRGSGtmbzZHd2Njc0NxY3oK",
      "endpoints": [
        "https://github.com/wblekhoa/speakease/releases/latest/download/latest.json"
      ]
    }
  }
}
